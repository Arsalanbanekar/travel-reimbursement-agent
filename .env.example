# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Chat model used by the agent. Must support native tool calling.
# Note: Groq retired the Llama chat models — llama-3.3-70b-versatile is gone.
GROQ_MODEL=openai/gpt-oss-120b

# Lighter model used if the primary one is rate-limited on the free tier.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local embedding model used to build and query the FAISS policy index.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum tool-calling iterations before the agent is forced to conclude.
MAX_AGENT_STEPS=8
